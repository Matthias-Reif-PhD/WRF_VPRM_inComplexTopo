#!/bin/bash
#SBATCH --mail-user=matthias.reif@student.uibk.ac.at
#SBATCH --mail-type=END,FAIL
#SBATCH --job-name=WRF_VPRM_CLC_9km
# 64, not 99: the 113x95 grid over 99 tasks decomposes to 9x11 patches of only
# ~10x10 cells, which aborts immediately. All the archived working 9km runs used
# 64 tasks (8x8 patches, ~14x12 cells). See campaign_time_estimate.md, which flags
# the 99-task setting as untested.
#SBATCH --ntasks=64
#SBATCH --cpus-per-task=1
#SBATCH --time=01:00:00

# Load modules and set environment variables
module purge
source ~/wrf_dev.sh
# run WRF
srun ./wrf.exe
echo "WRF done" 